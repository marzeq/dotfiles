{
  "layer": "bottom",
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["custom/updates", "temperature", "pulseaudio", "bluetooth", "tray"],
  "clock": {
    "interval": 1,
    "tooltip": false,
    "format": "{:%a %d %b %H:%M:%S}"
  },
  "custom/updates": {
    "format": " {}",
    "tooltip": false,
    "interval": 1800,
    "exec": "~/.config/waybar/update_count.sh",
    "on-click": "ghostty -e 'bash ~/.config/waybar/update_wrapper.sh'",
    "signal": 8
  },
  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon6/temp1_input",
    "format": " CPU: {temperatureC}°C",
    "critical-threshold": 60
  },
  "pulseaudio": {
    "tooltip": false,
    "scroll-step": 2, // %, can be a float
    "reverse-scrolling": 1,
    "format": " {volume}%",
    "format-muted": " ",
    "format-bluetooth": " {volume}%",
    "format-bluetooth-muted": " ",
    "on-click": "pavucontrol -t 3",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "bluetooth": {
    "format": " ",
    "format-connected-battery": " {device_battery_percentage}%",
    "on-click": "blueberry",
    "max-length": 15
  },
  "tray": {
    "spacing": 10
  }
}
