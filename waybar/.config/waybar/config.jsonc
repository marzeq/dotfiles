{
  "layer": "bottom",
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["custom/updates", "cpu", "memory", "pulseaudio", "tray"],
  "hyprland/window": {
    "format": "{}",
    "rewrite": {
      "YouTube — Mozilla Firefox": " YouTube",
      "(.*) - YouTube — Mozilla Firefox": " $1",
      "(?!YouTube)(.*) — Mozilla Firefox": "󰈹 $1",
      "Mozilla Firefox": "󰈹 Firefox",
      "(.*) - bash": " $1",
      "(.*) - zsh": " $1",
      "(.*) - NVIM": " $1",
      "(.*)Discord \\| (.*)": "  $2",
      "(.*)Discord": "  Discord",
      "Steam(.+)": "$1",
      "Steam": " Steam",
      "Alacritty(.*)": " Alacritty$1",
    },
  },
  "clock": {
    "interval": 1,
    "format": " {:%a %d %b 󰥔 %H:%M:%S}",
    "on-click": "swaync-client -t",
    "tooltip": false,
  },
  "custom/updates": {
    "format": " {}",
    "tooltip": false,
    "interval": 1800,
    "exec": "~/.config/waybar/updates.sh",
    "on-click": "alacritty -e paru && pkill -SIGRTMIN+8 waybar",
    "signal": 8,
  },
  "cpu": {
    "tooltip": false,
    "interval": 5,
    "format": " {usage}%",
    "on-click": "gnome-system-monitor",
  },
  "memory": {
    "tooltip": false,
    "interval": 5,
    "format": " {percentage}%",
    "on-click": "gnome-system-monitor",
  },
  "pulseaudio": {
    "tooltip": false,
    "scroll-step": 5, // %, can be a float
    "reverse-scrolling": 1,
    "format": "{volume}% 󰋋",
    "format-muted": "󰟎",
    "format-bluetooth": "{volume}% 󰋋",
    "format-bluetooth-muted": "󰟎",
    "on-click": "pavucontrol",
  },
  "tray": {
    "spacing": 10,
  },
}
