{
  "layer": "bottom",
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/updates",
    "cpu",
    "memory",
    "pulseaudio",
    "custom/mediacontrol",
    "network",
    "tray",
  ],
  "hyprland/window": {
    "format": "{}",
    "rewrite": {
      "YouTube — Mozilla Firefox": " YouTube",
      "(.*) - YouTube — Mozilla Firefox": " $1",
      "(?!YouTube)(.*) — Mozilla Firefox": "󰈹 $1",
      "Mozilla Firefox": "󰈹 Firefox",
      "(.*) - bash": " $1",
      "(.*) - zsh": " $1",
      "(.*) - NVIM": " $1",
      "(.*) - Discord": "  $1",
      "Discord": "  Discord",
      "Steam(.+)": " $1",
      "Steam": " Steam",
      "Alacritty(.*)": " Alacritty$1",
    },
    "max-length": 64,
  },
  "clock": {
    "interval": 1,
    "format": " {:%a %d %b 󰥔 %H:%M:%S}",
    "on-click": "gnome-calendar",
    "on-click-right": "swaync-client -t",
  },
  "custom/updates": {
    "format": "{}",
    "tooltip": false,
    "interval": 1800,
    "exec": "~/.config/waybar/updates.sh",
    "on-click": "alacritty -e paru && pkill -SIGRTMIN+8 waybar",
    "signal": 8,
  },
  "cpu": {
    "tooltip": false,
    "interval": 5,
    "format": " {usage}%",
    "on-click": "gnome-system-monitor",

    "states": {
      "critical": 80,
    },
  },
  "memory": {
    "tooltip": false,
    "interval": 5,
    "format": " {percentage}%",
    "on-click": "gnome-system-monitor",

    "states": {
      "critical": 80,
    },
  },
  "pulseaudio": {
    "tooltip": false,
    "scroll-step": 5, // %, can be a float
    "reverse-scrolling": 1,
    "format": "󰋋 {volume}%",
    "format-muted": "󰟎",
    "format-bluetooth": "󰋋 {volume}%",
    "format-bluetooth-muted": "󰟎",
    "on-click": "pavucontrol",
    "on-click-right": "blueberry",
    "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
  },
  "network": {
    "format": "",
    "format-disconnected": "󰅛",
    "format-disabled": "󰲛",
    "interval": 30,
  },
  "custom/mediacontrol": {
    "format": "󰝚 {}",
    "tooltip": true,
    "exec": "~/.config/waybar/getplayicon.sh",
    "interval": 1,
    "signal": 10,
    "on-click": "playerctl play-pause && pkill -SIGRTMIN+10 waybar",
    "on-scroll-up": "playerctl previous && pkill -SIGRTMIN+10 waybar",
    "on-scroll-down": "playerctl next && pkill -SIGRTMIN+10 waybar",
  },
  "tray": {
    "spacing": 10,
  },
}
