{
  "layer": "bottom",
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["custom/updates", "cpu", "memory", "pulseaudio", "custom/mediacontrol", "network", "tray"],
  "clock": {
    "interval": 1,
    "tooltip": false,
    "format": "{:%a %d %b %H:%M:%S}"
  },
  "custom/updates": {
    "format": "{}",
    "tooltip": false,
    "interval": 1800,
    "exec": "~/.config/waybar/updates.sh",
    "on-click": "ghostty -e ~/.config/waybar/updatesystem.sh",
    "signal": 8
  },
  "cpu": {
    "tooltip": false,
    "interval": 5,
    "format": " {usage}%",
    "on-click": "resources",

    "states": {
      "critical": 80
    }
  },
  "memory": {
    "tooltip": false,
    "interval": 5,
    "format": " {percentage}%",
    "on-click": "resources",

    "states": {
      "critical": 80
    }
  },
  "pulseaudio": {
    "tooltip": false,
    "scroll-step": 5, // %, can be a float
    "reverse-scrolling": 1,
    "format": "󰋋 {volume}%",
    "format-muted": "󰟎",
    "format-bluetooth": "󰋋 {volume}%",
    "format-bluetooth-muted": "󰟎",
    "on-click": "pavucontrol",
    "on-click-right": "blueberry",
    "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },
  "network": {
    "format": "",
    "format-disconnected": "󰅛",
    "format-disabled": "󰲛",
    "interval": 30
  },
  "custom/mediacontrol": {
    "format": "{}",
    "tooltip": true,
    "exec": "~/.config/waybar/getplayicon.sh",
    "interval": 1,
    "signal": 10,
    "on-click": "playerctl play-pause && pkill -SIGRTMIN+10 waybar",
    "on-scroll-up": "playerctl previous && pkill -SIGRTMIN+10 waybar",
    "on-scroll-down": "playerctl next && pkill -SIGRTMIN+10 waybar"
  },
  "tray": {
    "spacing": 10
  }
}
