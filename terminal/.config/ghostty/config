# vi: ft=mconf

# ┌───────────┐
# │ GUI STUFF │
# └───────────┘

window-decoration = true
resize-overlay = never
confirm-close-surface = false
gtk-single-instance = true

# ┌──────┐
# │ FONT │
# └──────┘

font-family = "CommitMono"
font-family = "Twemoji"
font-size = 12

# ┌────────────────────┐
# │ THEME & APPEARANCE │
# └────────────────────┘

theme = "Adwaita Dark"
background-opacity = 0.95

# ┌──────────┐
# │ KEYBINDS │
# └──────────┘

keybind = "clear"

keybind = "cmd+c=copy_to_clipboard"
keybind = "cmd+v=paste_from_clipboard"

keybind = "cmd+equal=increase_font_size:1"
keybind = "cmd+plus=increase_font_size:1"
keybind = "cmd+minus=decrease_font_size:1"
keybind = "cmd+zero=reset_font_size"

keybind = "cmd+q=quit"
keybind = "cmd+w=close_surface"

keybind = "ctrl+shift+c=copy_to_clipboard"
keybind = "ctrl+shift+v=paste_from_clipboard"

keybind = "ctrl+shift+equal=increase_font_size:1"
keybind = "ctrl+shift+plus=increase_font_size:1"
keybind = "ctrl+shift+minus=decrease_font_size:1"
keybind = "ctrl+shift+zero=reset_font_size"

keybind = "alt+shift+r=reload_config"

keybind = "alt+shift+h=new_split:left"
keybind = "alt+shift+j=new_split:down"
keybind = "alt+shift+k=new_split:up"
keybind = "alt+shift+l=new_split:right"

keybind = "alt+h=goto_split:left"
keybind = "alt+j=goto_split:bottom"
keybind = "alt+k=goto_split:top"
keybind = "alt+l=goto_split:right"

keybind = "alt+q=close_surface"

keybind = "alt+t=new_tab"

keybind = "alt+n=next_tab"
keybind = "alt+shift+n=previous_tab"

keybind = "ctrl+shift+v=paste_from_clipboard"
keybind = "ctrl+shift+c=copy_to_clipboard"
