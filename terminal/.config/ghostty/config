# vi: ft=mconf

# ┌───────────┐
# │ GUI STUFF │
# └───────────┘

window-decoration = true
resize-overlay = never
confirm-close-surface = false
gtk-single-instance = true

# ┌──────┐
# │ FONT │
# └──────┘

font-family = "CommitMono Nerd Font"
font-family = "Twemoji"
font-size = 12

# ┌────────────────────┐
# │ THEME & APPEARANCE │
# └────────────────────┘

theme = "Adwaita Dark"
background-opacity = 0.95

window-padding-x = "8,8"
window-padding-y = "8,8"

# ┌──────────┐
# │ KEYBINDS │
# └──────────┘

keybind = "clear"

keybind = "ctrl+shift+c=copy_to_clipboard"
keybind = "ctrl+shift+v=paste_from_clipboard"

keybind = "ctrl+shift+equal=increase_font_size:1"
keybind = "ctrl+shift+plus=increase_font_size:1"
keybind = "ctrl+shift+minus=decrease_font_size:1"
keybind = "ctrl+shift+zero=reset_font_size"

keybind = "alt+shift+r=reload_config"

keybind = "alt+shift+h=new_split:left"
keybind = "alt+shift+j=new_split:down"
keybind = "alt+shift+k=new_split:up"
keybind = "alt+shift+l=new_split:right"

keybind = "alt+h=goto_split:left"
keybind = "alt+j=goto_split:bottom"
keybind = "alt+k=goto_split:top"
keybind = "alt+l=goto_split:right"

keybind = "alt+shift+q=close_surface"

keybind = "ctrl+shift+v=paste_from_clipboard"
keybind = "ctrl+shift+c=copy_to_clipboard"
