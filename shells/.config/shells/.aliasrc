#!/usr/bin/env bash

function hascmd() {
  command -v $1 &> /dev/null
  return $?
}
if hascmd lsd; then
  alias ls="lsd"
else
  alias ls="ls --color=auto"
fi
alias la="ls -A"
alias grep="grep --color=auto"

alias c="clear"

if [ -f /etc/arch-release ]; then
  function remove-orphans() {
    orphans=$(pacman -Qdtq)
    if [ -n "$orphans" ]; then
      sudo pacman -Rns $(pacman -Qdtq)
    fi
  }

  if hascmd paru; then
    if hascmd waybar; then
      alias update-system="paru && remove-orphans"
    else
      alias update-system="paru && remove-orphans"
    fi
  fi
fi

if hascmd xdg-open; then
  function open() {
    (command xdg-open "$@" &> /dev/null &)
  }
fi


if hascmd mconf; then
  function mconftojson() {
    if [ -z "$1" ]; then
      echo "mconftojson: no file specified"
      return 1
    fi

    local output=$(mconf -j ${1})

    # check exit code
    if [ $? -ne 0 ]; then
      echo "mconftojson: failed to convert ${1} to JSON"
      return 1
    fi

    # replace .mconf extension with .json
    local json_file=${1%.mconf}.json

    echo $output > $json_file
  }
fi

if hascmd vim || hascmd nvim; then
  function sudo() {
    if [ "$1" = "vim" ] || [ "$1" = "nvim" ]; then
      shift
      sudoedit $@
    else
      command sudo $@
    fi
  }
fi

if hascmd git; then
  alias g="git"
  alias glg="git log --graph --decorate --all --pretty=format:'%C(auto)%h%d%C(#888888)(%an; %ar)%Creset %s'"

  alias gs="git status"
  alias gd="git diff"

  alias ga="git add"
  alias gc="git commit -m"
  alias gca="git commit -am"

  function gac() {
    if [[ ! " $@ " =~ " -- " ]]; then
      echo "gac: no -- found in arguments"
      return 1
    fi

    if [[ "$@" == *"--" ]]; then
      echo "gac: no commit message found"
      return 1
    fi

    local files=()
    local commit_message=""
    local found_double_dash=false

    for arg in "$@"; do
      if [ "$arg" = "--" ]; then
        found_double_dash=true
        continue
      fi

      if [ "$found_double_dash" = false ]; then
        files+=("$arg")
      else
        if [ -z "$commit_message" ]; then
          commit_message="$arg"
        else
          commit_message="$commit_message $arg"
        fi
      fi
    done

    if [ ${#files[@]} -eq 0 ]; then
      echo "gac: no files to add"
      return 1
    fi

    if [ -z "$commit_message" ]; then
      echo "gac: no commit message found"
      return 1
    fi

    git add "${files[@]}"
    if [ $? -ne 0 ]; then
      return 1
    fi
    git commit -m "$commit_message"
    return $?
  }

  alias gsb="git switch"
  alias gcb="git switch -c"

  alias gp="git push"
  alias gpl="git pull"
  alias gf="git fetch"
  
  function gv() {
    local remote_url=$(git config --get remote.origin.url)
    if [ $? -ne 0 ]; then
      echo "gv: no remote origin found"
      return 1
    fi

    if [[ "$remote_url" == git@github.com* ]]; then
      remote_url=${remote_url#*:}
      remote_url=${remote_url//:/\/}
      remote_url="https://github.com/${remote_url}"
    elif [[ "$remote_url" == https://* ]]; then
      :
    else
      echo "gv: invalid remote url: ${remote_url}"
      return 1
    fi

    (command xdg-open "$remote_url" &> /dev/null &)
  }
fi

if hascmd fastfetch && ! hascmd neofetch; then
  alias neofetch="fastfetch"
fi

if hascmd wl-copy; then
  function cpy() {
    cat $1 | wl-copy
  }
fi

function scratch() {
  local dir=$(mktemp -d)

  (cd $dir && $SHELL)
  rm -rf $dir
}

function loadenv() {
  if [ -z "$1" ]; then
    if [ -e ".env" ]; then
      set -a; source .env; set +a
    else
      echo "loadenv: no file specified and no .env file found in the current directory"
      return 1
    fi
  else
    if [ ! -e "$1" ]; then
      echo "loadenv: no such file or directory: ${1}"
      return 1
    fi

    if [ -d "$1" ]; then
      set -a; source ${1}/.env; set +a
    else
      set -a; source ${1}; set +a
    fi
  fi
}

function compress() {
  if [ "$#" -eq 0 ]; then
    echo "compress: no arguments specified"
    return 1
  fi

  directory=""
  compression_flag="z"
  extension=".tar.gz"

  for arg in "$@"; do
    if [ "$arg" = "-xz" ]; then
      if ! hascmd tar; then
        echo "compress: 'tar' command not found"
        return 1
      fi
      compression_flag="J"
      extension=".tar.xz"
    elif [ "$arg" = "-gz" ]; then
      if ! hascmd tar; then
        echo "compress: 'tar' command not found"
        return 1
      fi
      compression_flag="z"
      extension=".tar.gz"
    elif [ "$arg" = "-zip" ]; then
      if ! hascmd zip; then
        echo "compress: 'zip' command not found"
        return 1
      fi
      extension=".zip"
    elif [ "$arg" = "-7z" ]; then
      if ! hascmd 7z; then
        echo "compress: '7z' command not found"
        return 1
      fi
      extension=".7z"
    elif [[ "$arg" = -* ]]; then
      echo "compress: invalid flag: ${arg}"
      return 1
    else
      directory=$arg
    fi
  done

  if [ -z "$directory" ]; then
    echo "compress: no directory specified"
    return 1
  fi

  if [ ! -d "$directory" ]; then
    echo "compress: no such directory: ${directory}"
    return 1
  fi

  if [[ "$extension" == ".zip" ]]; then
    command="zip -qr ${directory}.zip ${directory}"
  elif [[ "$extension" == ".7z" ]]; then
    command="7z a ${directory}.7z ${directory}"
  else
    command="tar -c${compression_flag}f ${directory}${extension} ${directory}"
  fi

  echo $command
  eval $command > /dev/null
}

function extract() {
  if [ "$#" -eq 0 ]; then
    echo "extract: no file(s) specified"
    return 1
  fi

  for file in "$@"; do
    if [ ! -f "$file" ]; then
      echo "extract: no such file: ${file}"
      continue
    fi

    if [[ "$file" == *.tar.gz ]]; then
      if hascmd tar; then
        command="tar -xzf ${file}"
      else
        echo "extract: 'tar' command not found"
        continue
      fi
    elif [[ "$file" == *.tar.xz ]]; then
      if hascmd tar; then
        command="tar -xf ${file}"
      else
        echo "extract: 'tar' command not found"
        continue
      fi
    elif [[ "$file" == *.zip ]]; then
      if hascmd unzip; then
        command="unzip -q ${file}"
      else
        echo "extract: 'unzip' command not found"
        continue
      fi
    elif [[ "$file" == *.7z ]]; then
      if hascmd 7z; then
        command="7z x ${file}"
      else
        echo "extract: '7z' command not found"
        continue
      fi
    else
      extension=".${file#*.}"
      echo "extract: unknown file type: ${extension}"
      continue
    fi

    echo $command
    eval $command > /dev/null
  done
}
