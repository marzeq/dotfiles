#!/usr/bin/env bash

function hascmd() {
  command -v $1 &> /dev/null
  return $?
}

if hascmd lsd; then
  alias ls="lsd --group-dirs=first"
else
  alias ls="ls --color=auto"
fi
alias la="ls -A"
alias ll="ls -lh"
alias lla="ls -lhA"
alias grep="grep --color=auto"

alias c="clear"

alias ..="cd .."
alias ...="cd ../.."
function -() {
  cd -
}

if [ -f /etc/arch-release ]; then
  function remove-orphans() {
    orphans=$(pacman -Qdtq)
    if [ -n "$orphans" ]; then
      sudo pacman -Rns $(pacman -Qdtq)
    fi
  }

  if hascmd paru; then
    alias yay="paru"
  fi
fi

if hascmd xdg-open; then
  function open() {
    (command xdg-open "$@" &> /dev/null &)
  }
fi

if hascmd vim || hascmd nvim && hascmd sudoedit; then
  function sudo() {
    if [ "$1" = "vim" ] || [ "$1" = "nvim" ]; then
      shift
      sudoedit $@
    else
      command sudo $@
    fi
  }
fi

if hascmd lazygit; then
  alias lg="lazygit"
fi

if [ -d ~/.local/share/ignis ] && hascmd goignis && hascmd ignis && hascmd hyprctl; then
  function startshell() {
    hyprctl dispatch exec 'goignis init'
  }
fi

if hascmd background; then
  alias b="background"
fi

if hascmd git; then
  alias gcl="git clone"
  function ghcl() {
    local username repo

    if [[ "$1" =~ ^[^/]+/[^/]+$ ]]; then
      username=${1%%/*}
      repo=${1##*/}
    elif [[ "$1" =~ ^[^/]+$ ]]; then
      username=$(ssh -T git@github.com 2>&1 | sed -n 's/.*Hi \([^!]*\)!.*/\1/p')

      if [[ -z "$username" ]]; then
        echo "Could not determine GitHub username. Ensure SSH is configured."
        return 1
      fi

      repo="$1"
    else
      echo "Invalid repository format. Use 'username/repo' or 'repo'."
      return 1
    fi

    echo "Cloning '$username/$repo'..."
    git clone "git@github.com:$username/$repo.git" "${@:2}"
  }

  alias g="git"
  alias glg="git log --graph --decorate --all --pretty=format:'%C(auto)%h%d%C(#888888)(%an; %ar)%Creset %s'"

  alias gs="git status"
  alias gd="git diff"

  alias ga="git add"
  alias gc="git commit -m"
  alias gca="git commit -am"
  alias gcam="git commit --amend"

  alias gst="git stash"
  alias gstp="git stash pop"
  alias gsta="git stash apply"
  alias gstd="git stash drop"

  alias gsb="git switch"
  alias gcb="git switch -c"

  alias gp="git push"
  alias gpf="git push --force-with-lease"
  alias gpl="git pull"
  alias gf="git fetch"

  function gv() {
    local origin_url=$(git config --get remote.origin.url)

    if [ -z "$origin_url" ]; then
      echo "No remote origin URL found."
      return 1
    fi

    if [[ "$origin_url" == git@* ]]; then
      origin_url=$(echo "$origin_url" | sed -e 's/:/\//' -e 's/git@/https:\/\//')
    fi

    origin_url=${origin_url%.git}

    if [[ "$origin_url" == *github.com* ]]; then
      local branch=$(git branch --show-current)
      origin_url="$origin_url/tree/$branch"
    elif [[ "$origin_url" == *gitlab.com* ]]; then
      local branch=$(git branch --show-current)
      origin_url="$origin_url/-/tree/$branch"
    elif [[ "$origin_url" == *codeberg.org* ]]; then
      local branch=$(git branch --show-current)
      origin_url="$origin_url/src/branch/$branch"
    fi
    
    echo "Opening $origin_url"
    open "$origin_url"
  }

  alias gitundo="git reset --soft HEAD~1"
fi

if hascmd fastfetch && ! hascmd neofetch; then
  alias neofetch="fastfetch"
fi

function extract() {
  if [ "$#" -eq 0 ]; then
    echo "extract: no file(s) specified"
    return 1
  fi

  for file in "$@"; do
    if [ ! -f "$file" ]; then
      echo "extract: no such file: ${file}"
      continue
    fi

    if [[ "$file" == *.tar.gz ]]; then
      if hascmd tar; then
        command="tar -xzf ${file}"
      else
        echo "extract: 'tar' command not found"
        continue
      fi
    elif [[ "$file" == *.tar.xz ]]; then
      if hascmd tar; then
        command="tar -xf ${file}"
      else
        echo "extract: 'tar' command not found"
        continue
      fi
    elif [[ "$file" == *.zip ]]; then
      if hascmd unzip; then
        command="unzip -q ${file}"
      else
        echo "extract: 'unzip' command not found"
        continue
      fi
    elif [[ "$file" == *.7z ]]; then
      if hascmd 7z; then
        command="7z x ${file}"
      else
        echo "extract: '7z' command not found"
        continue
      fi
    else
      extension=".${file#*.}"
      echo "extract: unknown file type: ${extension}"
      continue
    fi

    echo $command
    eval $command
  done
}
